{
  "title": "PayFlow AI",
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate by endpoint",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_requests_total{path!=\"/metrics\"}[1m])) by (path)", "legendFormat": "{{path}}" }]
    },
    {
      "type": "timeseries",
      "title": "p95 latency by endpoint",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{path!=\"/metrics\"}[1m])) by (le, path))", "legendFormat": "{{path}}" }]
    },
    {
      "type": "timeseries",
      "title": "Transfers: success vs failure",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(rate(transfers_total[1m])) by (result)", "legendFormat": "{{result}}" }]
    },
    {
      "type": "timeseries",
      "title": "LLM p95 latency",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(llm_request_duration_seconds_bucket[5m])) by (le, step))", "legendFormat": "{{step}}" }]
    }
  ]
}
